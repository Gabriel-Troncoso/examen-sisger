{
	"name": "df_gold_movimientos_personal",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_movimientos_personal",
						"type": "DatasetReference"
					},
					"name": "srcmovimientos"
				},
				{
					"dataset": {
						"referenceName": "silver_efectivo",
						"type": "DatasetReference"
					},
					"name": "srcefectivos"
				},
				{
					"dataset": {
						"referenceName": "silver_unidades",
						"type": "DatasetReference"
					},
					"name": "srcunidades"
				},
				{
					"dataset": {
						"referenceName": "silver_rangos",
						"type": "DatasetReference"
					},
					"name": "srcrangos"
				},
				{
					"dataset": {
						"referenceName": "silver_tipos_movimientos",
						"type": "DatasetReference"
					},
					"name": "srctiposmovimiento"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_fact_movimientos_personal",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "joinEfectivo"
				},
				{
					"name": "joinUnidad"
				},
				{
					"name": "joinRango"
				},
				{
					"name": "joinTipoMovimiento"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_movimiento as integer,",
				"          id_efectivo as integer,",
				"          id_unidad_destino as integer,",
				"          id_rango as integer,",
				"          id_tipo as integer,",
				"          fecha_movimiento as date,",
				"          antiguedad_anios as integer,",
				"          salario_mensual as decimal(12,2),",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcmovimientos",
				"source(output(",
				"          id_efectivo as integer,",
				"          id_especialidad as integer,",
				"          id_unidad_actual as integer,",
				"          id_rango_actual as integer,",
				"          nombre as string,",
				"          ci as string,",
				"          fecha_nacimiento as date,",
				"          genero as string,",
				"          departamento_origen as string,",
				"          fecha_ingreso as date,",
				"          estado as string,",
				"          salario_mensual as decimal(12,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcefectivos",
				"source(output(",
				"          id_unidad as integer,",
				"          id_brigada as integer,",
				"          nombre as string,",
				"          codigo as string,",
				"          ciudad as string,",
				"          departamento as string,",
				"          tipo_cuartel as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcunidades",
				"source(output(",
				"          id_rango as integer,",
				"          nombre as string,",
				"          categoria as string,",
				"          nivel_jerarquico as integer,",
				"          abreviatura as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcrangos",
				"source(output(",
				"          id_tipo as integer,",
				"          nombre as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srctiposmovimiento",
				"srcmovimientos, srcefectivos join(srcmovimientos@id_efectivo == srcefectivos@id_efectivo,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinEfectivo",
				"joinEfectivo, srcunidades join(id_unidad_destino == id_unidad,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinUnidad",
				"joinUnidad, srcrangos join(srcmovimientos@id_rango == srcrangos@id_rango,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinRango",
				"joinRango, srctiposmovimiento join(srcmovimientos@id_tipo == srctiposmovimiento@id_tipo,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinTipoMovimiento",
				"joinTipoMovimiento derive(fecha_movimiento = coalesce(     toDate(toString(fecha_movimiento), 'yyyy-MM-dd'),     toDate(toString(fecha_movimiento), 'dd-MM-yyyy'),     toDate(toString(fecha_movimiento), 'dd/MM/yyyy'),     toDate(toString(fecha_movimiento), 'yyyy/MM/dd'),     toDate(toString(fecha_movimiento), 'dd/MMM/yyyy') ),",
				"          anio_movimiento = year(fecha_movimiento),",
				"          mes_movimiento = month(fecha_movimiento),",
				"          cantidad_movimientos = 1) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          id_movimiento,",
				"          id_efectivo = srcmovimientos@id_efectivo,",
				"          fecha_movimiento,",
				"          antiguedad_anios,",
				"          salario_mensual = srcmovimientos@salario_mensual,",
				"          observaciones,",
				"          id_efectivo = srcefectivos@id_efectivo,",
				"          nombre_efectivo = srcefectivos@nombre,",
				"          ci,",
				"          genero,",
				"          departamento_origen,",
				"          estado,",
				"          salario_mensual = srcefectivos@salario_mensual,",
				"          unidad_destino = srcunidades@nombre,",
				"          departamento_unidad = departamento,",
				"          id_rango = srcrangos@id_rango,",
				"          rango = srcrangos@nombre,",
				"          categoria_rango = categoria,",
				"          id_tipo = srctiposmovimiento@id_tipo,",
				"          tipo_movimiento = srctiposmovimiento@nombre,",
				"          anio_movimiento,",
				"          mes_movimiento,",
				"          cantidad_movimientos",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_movimiento as integer,",
				"          nombre_efectivo as string,",
				"          ci as string,",
				"          genero as string,",
				"          unidad_destino as string,",
				"          departamento_unidad as string,",
				"          rango as string,",
				"          tipo_movimiento as string,",
				"          fecha_movimiento as date,",
				"          anio_movimiento as integer,",
				"          mes_movimiento as integer,",
				"          antiguedad_anios as double,",
				"          salario_mensual as decimal(18,2),",
				"          cantidad_movimientos as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}