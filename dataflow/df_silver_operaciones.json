{
	"name": "df_silver_operaciones",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_sql_operaciones",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_operaciones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_operacion as string,",
				"          id_tipo as string,",
				"          id_unidad_resp as string,",
				"          id_zona as string,",
				"          nombre_operacion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          efectivos_desplegados as string,",
				"          vehiculos_utilizados as string,",
				"          duracion_dias as string,",
				"          costo_operacion as string,",
				"          resultado as string,",
				"          detenidos as string,",
				"          area_km2 as string,",
				"          incidentes as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    CAST(id_operacion AS VARCHAR(50)) AS id_operacion,\\n    CAST(id_tipo AS VARCHAR(50)) AS id_tipo,\\n    CAST(id_unidad_resp AS VARCHAR(50)) AS id_unidad_resp,\\n    CAST(id_zona AS VARCHAR(50)) AS id_zona,\\n    CAST(nombre_operacion AS VARCHAR(255)) AS nombre_operacion,\\n    CAST(fecha_inicio AS VARCHAR(50)) AS fecha_inicio,\\n    CAST(fecha_fin AS VARCHAR(50)) AS fecha_fin,\\n    CAST(efectivos_desplegados AS VARCHAR(50)) AS efectivos_desplegados,\\n    CAST(vehiculos_utilizados AS VARCHAR(50)) AS vehiculos_utilizados,\\n    CAST(duracion_dias AS VARCHAR(50)) AS duracion_dias,\\n    CAST(costo_operacion AS VARCHAR(50)) AS costo_operacion,\\n    CAST(resultado AS VARCHAR(255)) AS resultado,\\n    CAST(detenidos AS VARCHAR(50)) AS detenidos,\\n    CAST(area_km2 AS VARCHAR(50)) AS area_km2,\\n    CAST(incidentes AS VARCHAR(50)) AS incidentes,\\n    CAST(observaciones AS VARCHAR(500)) AS observaciones\\nFROM bronze.tbl_operaciones\\nWHERE id_operacion IS NOT NULL\\n  AND TRIM(CAST(id_operacion AS VARCHAR(50))) <> \\'\\'',",
				"     format: 'query') ~> source1",
				"source1 derive(id_operacion = toInteger(trim(toString(id_operacion))),",
				"          id_tipo = toInteger(trim(id_tipo)),",
				"          id_unidad_resp = toInteger(trim(id_unidad_resp)),",
				"          id_zona = toInteger(trim(id_zona)),",
				"          nombre_operacion = initCap(lower(trim(nombre_operacion))),",
				"          fecha_inicio = coalesce(     toDate(fecha_inicio, 'yyyyMMdd'),     toDate(fecha_inicio, 'yyyy-MM-dd'),     toDate(fecha_inicio, 'dd-MM-yyyy'),     toDate(fecha_inicio, 'dd/MM/yyyy'),     toDate(fecha_inicio, 'MM-dd-yyyy'),     toDate(fecha_inicio, 'yyyy/MM/dd'),     toDate(fecha_inicio, 'dd-MMM-yyyy'),     toDate(fecha_inicio, 'dd/MMM/yyyy'),     toDate(fecha_inicio, 'MMMM dd, yyyy'),     toDate(fecha_inicio, \"dd 'de' MMMM 'de' yyyy\") ) ,",
				"          fecha_fin = coalesce(     toDate(fecha_fin, 'yyyyMMdd'),     toDate(fecha_fin, 'yyyy-MM-dd'),     toDate(fecha_fin, 'dd-MM-yyyy'),     toDate(fecha_fin, 'dd/MM/yyyy'),     toDate(fecha_fin, 'MM-dd-yyyy'),     toDate(fecha_fin, 'yyyy/MM/dd'),     toDate(fecha_fin, 'dd-MMM-yyyy'),     toDate(fecha_fin, 'dd/MMM/yyyy'),     toDate(fecha_fin, 'MMMM dd, yyyy'),     toDate(fecha_fin, \"dd 'de' MMMM 'de' yyyy\") ),",
				"          vehiculos_utilizados = toInteger(\r",
				"    iif(\r",
				"        length(\r",
				"            regexReplace(\r",
				"                regexReplace(\r",
				"                    regexReplace(\r",
				"                        regexReplace(\r",
				"                            regexReplace(\r",
				"                                regexReplace(\r",
				"                                    regexReplace(\r",
				"                                        regexReplace(\r",
				"                                            regexReplace(\r",
				"                                                regexReplace(\r",
				"                                                    regexReplace(\r",
				"                                                        regexReplace(\r",
				"                                                            regexReplace(\r",
				"                                                                lower(trim(vehiculos_utilizados)),\r",
				"                                                                `aprox\\.?\\s*`,\r",
				"                                                                ''\r",
				"                                                            ),\r",
				"                                                            `veh[ií]culos?`,\r",
				"                                                            ''\r",
				"                                                        ),\r",
				"                                                        `[()]`,\r",
				"                                                        ''\r",
				"                                                    ),\r",
				"                                                    `ciento cincuenta`,\r",
				"                                                    '150'\r",
				"                                                ),\r",
				"                                                `ciento veinte`,\r",
				"                                                '120'\r",
				"                                            ),\r",
				"                                            `doscientas`,\r",
				"                                            '200'\r",
				"                                        ),\r",
				"                                        `doscientos`,\r",
				"                                        '200'\r",
				"                                    ),\r",
				"                                    `trescientas`,\r",
				"                                    '300'\r",
				"                                ),\r",
				"                                `trescientos`,\r",
				"                                '300'\r",
				"                            ),\r",
				"                            `quinientos`,\r",
				"                            '500'\r",
				"                        ),\r",
				"                        `cuatrocientos`,\r",
				"                        '400'\r",
				"                    ),\r",
				"                    `cincuenta`,\r",
				"                    '50'\r",
				"                ),\r",
				"                `treinta`,\r",
				"                '30'\r",
				"            )\r",
				"        ) > 0,\r",
				"        regexReplace(\r",
				"            regexReplace(\r",
				"                regexReplace(\r",
				"                    regexReplace(\r",
				"                        regexReplace(\r",
				"                            regexReplace(\r",
				"                                regexReplace(\r",
				"                                    regexReplace(\r",
				"                                        regexReplace(\r",
				"                                            regexReplace(\r",
				"                                                regexReplace(\r",
				"                                                    regexReplace(\r",
				"                                                        regexReplace(\r",
				"                                                            lower(trim(vehiculos_utilizados)),\r",
				"                                                            `aprox\\.?\\s*`,\r",
				"                                                            ''\r",
				"                                                        ),\r",
				"                                                        `veh[ií]culos?`,\r",
				"                                                        ''\r",
				"                                                    ),\r",
				"                                                    `[()]`,\r",
				"                                                    ''\r",
				"                                                ),\r",
				"                                                `ciento cincuenta`,\r",
				"                                                '150'\r",
				"                                            ),\r",
				"                                            `ciento veinte`,\r",
				"                                            '120'\r",
				"                                        ),\r",
				"                                        `doscientas`,\r",
				"                                        '200'\r",
				"                                    ),\r",
				"                                    `doscientos`,\r",
				"                                    '200'\r",
				"                                ),\r",
				"                                `trescientas`,\r",
				"                                '300'\r",
				"                            ),\r",
				"                            `trescientos`,\r",
				"                            '300'\r",
				"                        ),\r",
				"                        `quinientos`,\r",
				"                        '500'\r",
				"                    ),\r",
				"                    `cuatrocientos`,\r",
				"                    '400'\r",
				"                ),\r",
				"                `cincuenta`,\r",
				"                '50'\r",
				"            ),\r",
				"            `treinta`,\r",
				"            '30'\r",
				"        ),\r",
				"        '0'\r",
				"    )\r",
				"),",
				"          duracion_dias = toInteger(\r",
				"    iif(\r",
				"        length(\r",
				"            regexReplace(\r",
				"                regexReplace(\r",
				"                    regexReplace(\r",
				"                        regexReplace(\r",
				"                            lower(trim(duracion_dias)),\r",
				"                            `aprox\\.?\\s*`,\r",
				"                            ''\r",
				"                        ),\r",
				"                        `~`,\r",
				"                        ''\r",
				"                    ),\r",
				"                    `d[ií]as?`,\r",
				"                    ''\r",
				"                ),\r",
				"                `[()]`,\r",
				"                ''\r",
				"            )\r",
				"        ) > 0,\r",
				"        regexReplace(\r",
				"            regexReplace(\r",
				"                regexReplace(\r",
				"                    regexReplace(\r",
				"                        lower(trim(duracion_dias)),\r",
				"                        `aprox\\.?\\s*`,\r",
				"                        ''\r",
				"                    ),\r",
				"                    `~`,\r",
				"                    ''\r",
				"                ),\r",
				"                `d[ií]as?`,\r",
				"                ''\r",
				"            ),\r",
				"            `[()]`,\r",
				"            ''\r",
				"        ),\r",
				"        '0'\r",
				"    )\r",
				"),",
				"          resultado = initCap(lower(trim(resultado))),",
				"          detenidos = toInteger(iif(   regexMatch(lower(trim(detenidos)), `^(-|sin detenidos|ninguno|n/a|null|)$`),   '0',   iif(lower(trim(detenidos)) == 'cero', '0',   iif(lower(trim(detenidos)) == 'uno', '1',   iif(lower(trim(detenidos)) == 'veinte', '20',   regexReplace(regexReplace(regexReplace(     lower(trim(detenidos)),     `aprox\\.?\\s*`, ''),     `(pers\\.|personas|detenidos|det\\.)`, ''),     `[^0-9]`, '')   ))) )),",
				"          area_km2 = toDouble(regexReplace(regexReplace(regexReplace(   lower(trim(area_km2)),   `aprox\\.?\\s*`, ''),   `(km²|km2|~|null)`, ''),   `[^0-9.]`, '') ),",
				"          incidentes = toInteger(iif(\r",
				"  regexMatch(lower(trim(incidentes)), `^(-|sin incidentes|ninguno|n/a|null|s/d|)$`),\r",
				"  '0',\r",
				"  iif(lower(trim(incidentes)) == 'cero', '0',\r",
				"  iif(lower(trim(incidentes)) == 'uno', '1',\r",
				"  iif(lower(trim(incidentes)) == 'tres', '3',\r",
				"  regexReplace(regexReplace(regexReplace(\r",
				"    lower(trim(incidentes)),\r",
				"    `aprox\\.?\\s*`, ''),\r",
				"    `(incidentes|inc\\.)`, ''),\r",
				"    `[^0-9]`, '')\r",
				"  ))))\r",
				"),",
				"          observaciones = iif(isNull(observaciones) || trim(observaciones) == '', 'Sin observaciones', initCap(lower(trim(observaciones)))),",
				"          efectivos_desplegados = toInteger(iif(\r",
				"  length(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(\r",
				"    lower(trim(efectivos_desplegados)),\r",
				"  `aprox\\.?\\s*`, ''),\r",
				"  `efectivos`, ''),\r",
				"  `[()]`, ''),\r",
				"  `ciento cincuenta`, '150'),\r",
				"  `ciento veinte`, '120'),\r",
				"  `doscientas`, '200'),\r",
				"  `doscientos`, '200'),\r",
				"  `trescientas`, '300'),\r",
				"  `trescientos`, '300'),\r",
				"  `quinientos`, '500'),\r",
				"  `cuatrocientos`, '400'),\r",
				"  `cincuenta`, '50'),\r",
				"  `treinta`, '30')\r",
				"  ) > 0,\r",
				"  regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(\r",
				"    lower(trim(efectivos_desplegados)),\r",
				"  `aprox\\.?\\s*`, ''),\r",
				"  `efectivos`, ''),\r",
				"  `[()]`, ''),\r",
				"  `ciento cincuenta`, '150'),\r",
				"  `ciento veinte`, '120'),\r",
				"  `doscientas`, '200'),\r",
				"  `doscientos`, '200'),\r",
				"  `trescientas`, '300'),\r",
				"  `trescientos`, '300'),\r",
				"  `quinientos`, '500'),\r",
				"  `cuatrocientos`, '400'),\r",
				"  `cincuenta`, '50'),\r",
				"  `treinta`, '30')\r",
				")),",
				"          costo_operacion = concat(   toString(round(     iif(       regexMatch(lower(trim(costo_operacion)), `^(usd|\\$us).*`),       toDouble(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(         regexReplace(lower(trim(costo_operacion)),         `(usd|\\$us|bs\\.?-?|bolivianos)`, ''),         `\\s+`, ''),         `(\\d)\\.(\\d{3}),(\\d+)`, '$1$2.$3'),         `(\\d)\\.(\\d{3})$`, '$1$2'),         `,`, ''),         `[^0-9.]`, '')       ) * 6.96,       toDouble(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(         regexReplace(lower(trim(costo_operacion)),         `(usd|\\$us|bs\\.?-?|bolivianos)`, ''),         `\\s+`, ''),         `(\\d)\\.(\\d{3}),(\\d+)`, '$1$2.$3'),         `(\\d)\\.(\\d{3})$`, '$1$2'),         `,`, ''),         `[^0-9.]`, '')       )     )   , 2)),   ' Bs' )) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_operacion as integer,",
				"          id_tipo as integer,",
				"          id_unidad_resp as integer,",
				"          id_zona as integer,",
				"          nombre_operacion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          efectivos_desplegados as integer,",
				"          vehiculos_utilizados as integer,",
				"          duracion_dias as integer,",
				"          costo_operacion as decimal(14,2),",
				"          resultado as string,",
				"          detenidos as integer,",
				"          area_km2 as decimal(12,2),",
				"          incidentes as integer,",
				"          observaciones as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_operacion,",
				"          id_tipo,",
				"          id_unidad_resp,",
				"          id_zona,",
				"          nombre_operacion,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          efectivos_desplegados,",
				"          vehiculos_utilizados,",
				"          duracion_dias,",
				"          costo_operacion,",
				"          resultado,",
				"          detenidos,",
				"          area_km2,",
				"          incidentes,",
				"          observaciones",
				"     )) ~> sink1"
			]
		}
	}
}