{
	"name": "df_silver_rangos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_sql_rangos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_rangos",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_rango as string,",
				"          nombre as string,",
				"          categoria as string,",
				"          nivel_jerarquico as string,",
				"          abreviatura as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    CAST(id_rango AS VARCHAR(50)) AS id_rango,\\n    CAST(nombre AS VARCHAR(150)) AS nombre,\\n    CAST(categoria AS VARCHAR(100)) AS categoria,\\n    CAST(nivel_jerarquico AS VARCHAR(50)) AS nivel_jerarquico,\\n    CAST(abreviatura AS VARCHAR(50)) AS abreviatura\\nFROM bronze.tbl_rangos\\nWHERE id_rango IS NOT NULL\\n  AND TRIM(CAST(id_rango AS VARCHAR(50))) <> \\'\\'',",
				"     format: 'query') ~> source1",
				"source1 derive(id_rango = toInteger(trim(id_rango)),",
				"          nombre = initCap(lower(trim(nombre))),",
				"          categoria = initCap(lower(trim(categoria))),",
				"          nivel_jerarquico = toInteger(trim(nivel_jerarquico)),",
				"          abreviatura = upper(trim(abreviatura))) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_rango as integer,",
				"          nombre as string,",
				"          categoria as string,",
				"          nivel_jerarquico as integer,",
				"          abreviatura as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['DELETE FROM silver.rangos;'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}